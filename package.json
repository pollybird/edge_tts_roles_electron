{
  "name": "edge-tts-roles",
  "version": "2.0.4",
  "description": "Edge-TTS 多角色音频生成器",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "author": "泰州姜堰钟毓信息技术有限公司 <44961355+pollybird@users.noreply.github.com>",
  "homepage": "https://github.com/pollybird/edge_tts_roles_electron",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prepare:ffmpeg": "node scripts/download-ffmpeg-binaries.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "prebuild:unpack": "npm run prepare:ffmpeg",
    "prebuild:win": "npm run prepare:ffmpeg",
    "build:win": "npm run build && node scripts/package-dist.mjs win nsis --x64 --arm64",
    "prebuild:mac": "npm run prepare:ffmpeg",
    "build:mac": "npm run build && node scripts/package-dist.mjs mac dmg zip --x64 --arm64",
    "prebuild:mac:zip": "npm run prepare:ffmpeg",
    "build:mac:zip": "npm run build && node scripts/package-dist.mjs mac zip --x64 --arm64",
    "prebuild:linux": "npm run prepare:ffmpeg",
    "build:linux": "npm run build && node scripts/package-dist.mjs linux AppImage deb rpm --x64 --arm64",
    "build:all": "npm run build:linux && npm run build:win && npm run build:mac:zip",
    "release:gitcode": "node scripts/publish-gitcode.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "edge-tts-universal": "^1.4.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
